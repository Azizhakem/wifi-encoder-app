[app]
# اسم التطبيق الخاص بك
title = Wifi Encoder
package.name = wifiencoder
package.domain = org.encoder

# اسم ملف الكود الرئيسي
source.include_exts = py,png,jpg,kv,atlas
source.dir = .

# الإصدار والمكتبات المطلوبة
version = 0.1
requirements = python3,kivy

# إعدادات الأندرويد
orientation = portrait
fullscreen = 0
android.permissions = INTERNET
